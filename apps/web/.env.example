# Copy to .env.local for local dev; set the same keys as Vercel project env vars.
SUPABASE_URL=https://qkmgmzhrwduvigccwgcz.supabase.co
SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser, never prefix with NEXT_PUBLIC_.
# Used by lib/supabase/service.ts (M2) — the waiver API routes' Storage
# upload/signed-URL and the two intake_forms columns a client's own session
# is deliberately forbidden from writing (see 0005_m2_clients_intake.sql).
SUPABASE_SERVICE_ROLE_KEY=

# Same project/anon key as above, duplicated under NEXT_PUBLIC_ so the browser
# Supabase client (login form, admin user search — see lib/supabase/client.ts)
# can read them. The anon key is safe to expose: RLS is what scopes what it
# can see. The admin surface never uses SUPABASE_SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://qkmgmzhrwduvigccwgcz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. The single consumer is app/api/ai/program-draft/route.ts (M3) —
# the AI broker. No other code path may read it, and it must never be prefixed
# with NEXT_PUBLIC_: the mobile app calls that route rather than Anthropic
# directly precisely so this key never leaves the server.
ANTHROPIC_API_KEY=
