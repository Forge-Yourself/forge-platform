# Copy to .env. Both values are safe to expose in a client bundle — RLS is the boundary.
# Get them with: supabase projects api-keys --project-ref qkmgmzhrwduvigccwgcz
EXPO_PUBLIC_SUPABASE_URL=https://qkmgmzhrwduvigccwgcz.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# apps/web's deployed origin — used to build the /join invite link (M2). No
# trailing slash. Defaults to production in lib/webHost.ts if unset, so this
# only needs setting to point invite links at a Vercel preview during testing.
EXPO_PUBLIC_WEB_HOST=https://forge-admin-one.vercel.app
