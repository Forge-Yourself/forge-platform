{
  "expo": {
    "name": "Forge",
    "slug": "forge",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "forge",
    "userInterfaceStyle": "automatic",
    "extra": {
      "supportsRTL": true,
      "router": {},
      "eas": {
        "projectId": "d26a36f3-7916-48b8-9d32-2e75e611ae8f"
      }
    },
    "ios": {
      "bundleIdentifier": "app.forge.mobile",
      "supportsTablet": true,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ExpoLocalization_supportsRTL": true
      }
    },
    "android": {
      "package": "app.forge.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1A1F2B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1F2B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-audio",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Forge uses the camera to take progress photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Forge lets you choose a progress photo from your library.",
          "cameraPermission": "Forge uses the camera to take progress photos."
        }
      ],
      "expo-widgets",
      ["expo-notifications", { "sounds": ["./assets/sounds/timer-done.wav"] }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "josephaddad1"
  }
}
