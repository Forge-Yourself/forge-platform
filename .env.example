# Repo-root secrets used by CLI work, not by any app at runtime.
# Copy to .env — .env is gitignored.

# Supabase dashboard -> Project Settings -> Database. Used by `supabase db push`.
SUPABASE_DB_PASSWORD=

# Resend (https://resend.com) API key used as the custom SMTP password for Supabase Auth emails.
# Referenced from supabase/config.toml as env(RESEND_API_KEY) via `supabase config push`.
RESEND_API_KEY=
